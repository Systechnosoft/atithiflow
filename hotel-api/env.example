## Backend environment example for AtithiFlow

# Supabase / authentication
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="secure_password_here"

# API configuration
PORT=3000
ALLOWED_ORIGINS="*"

# Database configuration
DATABASE_URL="postgresql://atithi:atithi_password@db:5432/atithiflow"

# Optional local database values for reference
# POSTGRES_DB=atithiflow
# POSTGRES_USER=atithi
# POSTGRES_PASSWORD=atithi_password
